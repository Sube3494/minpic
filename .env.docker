# ============================================
# MinPic Docker Environment Configuration
# ============================================

# --- Database (PostgreSQL) ---
# Values here should match docker-compose.yaml if using defaults
DB_USER=minpic
DB_PASSWORD=your_secure_password_here
DB_NAME=minpic

# --- Redis ---
# Default port is 6379, usually no need to change for internal docker network
REDIS_URL=redis://redis:6379

# --- Application ---
# The port where your app is accessible on the host
APP_PORT=3210

# --- NextAuth.js ---
# IMPORTANT: For production, use your actual domain (e.g., https://minpic.your-domain.com)
# For local testing via Docker, you can use http://localhost:${APP_PORT}
NEXTAUTH_URL=https://your-domain.com
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_auth_secret_here
AUTH_TRUST_HOST=true

# --- GitHub OAuth ---
# Create OAuth App at: https://github.com/settings/developers
# Homepage URL: Your production domain (e.g., https://minpic.your-domain.com)
# Callback URL: Your production domain + /api/auth/callback/github
GITHUB_ID=your_github_client_id
GITHUB_SECRET=your_github_client_secret

# --- Admin Setup ---
# Get your numeric GitHub User ID from: https://api.github.com/users/YOUR_GITHUB_USERNAME
# (Look for the "id" field in the JSON response)
ADMIN_GITHUB_ID=your_github_id

# --- Security ---
# Must be exactly 32 characters for AES-256
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64').slice(0,32))"
CONFIG_ENCRYPTION_KEY=your_32_character_key_here
