# ============================================
# Database Configuration
# ============================================
DATABASE_URL="postgresql://user:password@ip:port/sqlname"

# ============================================
# SMTP Email Configuration
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM="MinPic <your_email@example.com>"
SMTP_SECURE=true
# ============================================
# NextAuth.js Authentication
# ============================================
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-generate-with-openssl-rand-base64-32

# ============================================
# GitHub OAuth
# ============================================
# Create OAuth App at: https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/auth/callback/github
# GITHUB_PROXY_URL=https://git.sube.top # (Optional) Use for HK-based reverse proxy (e.g., via Caddy/Nginx on HK VPS)
GITHUB_ID=your-github-oauth-app-client-id
GITHUB_SECRET=your-github-oauth-app-client-secret

# ============================================
# Admin Setup
# ============================================
# The email address of the initial administrator.
# Anyone logging in with this email (via GitHub or Credentials) will get ADMIN role.
ADMIN_EMAIL=your-admin@example.com

# ============================================
# Security - Config Encryption (Optional but Recommended)
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64').slice(0,32))"
# Must be exactly 32 characters for AES-256
CONFIG_ENCRYPTION_KEY=your-32-character-encryption-key

# ============================================
# Performance - Redis Cache (Optional)
# ============================================
# For production, use Redis to improve performance
# Leave empty to use in-memory cache (development only)
# REDIS_URL=redis://:password@localhost:6379
# REDIS_TOKEN=your-redis-token-if-using-upstash
