// Prisma schemafile

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// User Authentication & Authorization
// ============================================

// UserRole: ADMIN | USER
// UserStatus: ACTIVE | SUSPENDED | BANNED

model User {
  id String @id @default(cuid())

  // GitHub OAuth info
  githubId String  @unique
  username String  @unique
  name     String?
  email    String? @unique
  avatar   String?

  // Role and status
  role   String @default("USER") // ADMIN | USER
  status String @default("ACTIVE") // ACTIVE | SUSPENDED | BANNED

  // Usage statistics (for display only)
  storageUsed BigInt @default(0)
  fileCount   Int    @default(0)

  // Metadata
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  accounts  Account[]
  sessions  Session[]
  configs   Config[]
  files     File[]
  auditLogs AuditLog[]

  // Team relations
  ownedTeam          Team?             @relation("TeamOwner")
  teamMembership     TeamMember?
  createdInviteCodes InviteCode[]
  multipartUploads   MultipartUpload[]

  @@index([githubId])
  @@index([username])
  @@index([role])
  @@index([status])
  @@map("users")
}

// NextAuth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// Registration Control
// ============================================

model RegistrationWhitelist {
  id        String    @id @default(cuid())
  githubId  String    @unique
  username  String
  addedBy   String
  reason    String?
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([githubId])
  @@index([used])
  @@map("registration_whitelist")
}

// ============================================
// System Settings
// ============================================

model SystemSettings {
  id String @id @default(cuid())

  // Registration control
  registrationEnabled Boolean @default(false)
  requireWhitelist    Boolean @default(true)

  // Default quotas removed - now managed at team level

  // Site info
  siteName        String  @default("MinPic")
  siteDescription String?

  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ============================================
// Audit Logging
// ============================================

// AuditAction: USER_LOGIN | USER_CREATED | USER_UPDATED | USER_SUSPENDED | USER_BANNED |
//              WHITELIST_ADDED | WHITELIST_REMOVED | QUOTA_UPDATED |
//              FILE_UPLOADED | FILE_DELETED | CONFIG_CREATED | CONFIG_DELETED

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // See AuditAction values above
  targetType String?
  targetId   String?
  metadata   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// Application Data
// ============================================

// Config table
model Config {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("configs")
}

// File table
model File {
  id            String    @id @default(cuid())
  userId        String
  filename      String
  minioPath     String // 缁夊锟?@unique閿涘本鏁奸悽銊ワ拷閸氬牆鏁稉鈧痪锔芥将
  fileSize      BigInt
  mimeType      String
  fileType      String
  thumbnailPath String?
  thumbnailData Bytes?
  width         Int?
  height        Int?
  duration      Float?
  tags          String    @default("[]")
  pinyin        String?
  configId      String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, minioPath]) // 婢跺秴鎮庨崬锟界缁撅附娼敍姘倱娑撯偓閻劍鍩涙稉宥堝厴閺堝娴夐崥宀冪熅瀵板嫮娈戦弬鍥︽
  @@index([userId])
  @@index([fileType])
  @@index([createdAt])
  @@index([pinyin])
  @@index([configId])
  @@map("files")
}

// ============================================
// Team Management
// ============================================

model Team {
  id          String  @id @default(cuid())
  name        String
  description String?

  ownerId String @unique
  owner   User   @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Team quotas (set by team owner)
  storageQuota BigInt @default(5368709120) // 5GB default
  fileQuota    Int    @default(10000) // 10000 files default

  // Auto-allocation settings
  autoAllocateQuota   Boolean @default(false)
  defaultStorageQuota BigInt  @default(0)
  defaultFileQuota    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     TeamMember[]
  inviteCodes InviteCode[]

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id String @id @default(cuid())

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role String @default("MEMBER") // ADMIN | MEMBER

  // 閹存劕鎲抽悪锟界彌闁板秹锟介敍鍫濆讲闁绱歯ull鐞涖劎銇氭担璺ㄦ暏閸ャ垽妲﹂柊宥夛拷
  storageQuota BigInt? // 鐎涙ê鍋嶉柊宥夛拷閿涘牆鐡ч懞鍌︾礆
  fileQuota    Int? // 閺傚洣娆㈤弫浼村帳妫帮拷

  inviteCodeId String?
  inviteCode   InviteCode? @relation(fields: [inviteCodeId], references: [id], onDelete: SetNull)

  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([inviteCodeId])
  @@map("team_members")
}

model InviteCode {
  id   String @id @default(cuid())
  code String @unique // 32娴ｅ秹鍊嬬拠椋庣垳

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdBy String
  creator   User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  expiresAt DateTime // 鏉╁洦婀￠弮鍫曟？
  maxUses   Int      @default(5) // 最大使用次数
  usedCount Int      @default(0) // 已使用次数

  members TeamMember[]

  createdAt DateTime @default(now())

  @@index([teamId])
  @@index([code])
  @@index([createdBy])
  @@map("invite_codes")
}

// ============================================
// Multipart Upload (鍒嗙墖涓婁紶)
// ============================================

model MultipartUpload {
  id       String @id @default(cuid())
  uploadId String @unique // MinIO Upload ID

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  filename String
  fileSize BigInt
  mimeType String

  bucket    String
  objectKey String

  // 宸蹭笂浼犵殑鍒嗙墖淇℃伅 (JSON 瀛楃涓?
  parts String @default("[]") // Array<{ partNumber: number, etag: string }>

  status String @default("pending") // pending | completed | aborted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // 24灏忔椂鍚庤繃鏈?
  @@index([userId])
  @@index([uploadId])
  @@index([status])
  @@index([expiresAt])
  @@map("multipart_uploads")
}