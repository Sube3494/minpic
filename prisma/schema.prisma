generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(cuid())
  githubId           String?           @unique
  username           String            @unique
  password           String?
  name               String?
  email              String?           @unique
  avatar             String?
  role               String            @default("USER")
  status             String            @default("ACTIVE")
  storageUsed        BigInt            @default(0)
  fileCount          Int               @default(0)
  lastLoginAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  accounts           Account[]
  auditLogs          AuditLog[]
  collections        Collection[]
  configs            Config[]
  files              File[]
  createdInviteCodes InviteCode[]
  multipartUploads   MultipartUpload[]
  sessions           Session[]
  teamMembership     TeamMember?
  ownedTeam          Team?             @relation("TeamOwner")

  @@index([githubId])
  @@index([username])
  @@index([role])
  @@index([status])
  @@index([lastLoginAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expires])
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model RegistrationWhitelist {
  id        String    @id @default(cuid())
  githubId  String?   @unique
  email     String?   @unique
  username  String
  addedBy   String
  reason    String?
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([githubId])
  @@index([used])
  @@map("registration_whitelist")
}

model SystemSettings {
  id                  String   @id @default(cuid())
  registrationEnabled Boolean  @default(false)
  requireWhitelist    Boolean  @default(true)
  siteName            String   @default("MinPic")
  siteDescription     String?
  uploadRateLimit     Int      @default(100)
  githubLoginEnabled  Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  @@map("system_settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId, action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), userId, action])
  @@index([action])
  @@map("audit_logs")
}

model Config {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("configs")
}

model File {
  id              String           @id @default(cuid())
  userId          String
  filename        String
  minioPath       String
  fileSize        BigInt
  mimeType        String
  fileType        String
  thumbnailPath   String?
  thumbnailData   Bytes?
  width           Int?
  height          Int?
  duration        Float?
  tags            String           @default("[]")
  pinyin          String?
  configId        String?
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  collectionItems CollectionItem[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, minioPath])
  @@index([userId])
  @@index([fileType])
  @@index([createdAt])
  @@index([pinyin])
  @@index([configId])
  @@index([userId, fileType, createdAt(sort: Desc)])
  @@index([userId, configId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), fileType])
  @@map("files")
}

model Team {
  id                  String       @id @default(cuid())
  name                String
  description         String?
  ownerId             String       @unique
  storageQuota        BigInt       @default(5368709120)
  fileQuota           Int          @default(10000)
  autoAllocateQuota   Boolean      @default(false)
  defaultStorageQuota BigInt       @default(0)
  defaultFileQuota    Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  inviteCodes         InviteCode[]
  members             TeamMember[]
  owner               User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id           String      @id @default(cuid())
  teamId       String
  userId       String      @unique
  role         String      @default("MEMBER")
  storageQuota BigInt?
  fileQuota    Int?
  inviteCodeId String?
  joinedAt     DateTime    @default(now())
  inviteCode   InviteCode? @relation(fields: [inviteCodeId], references: [id])
  team         Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([inviteCodeId])
  @@index([teamId, userId])
  @@map("team_members")
}

model InviteCode {
  id        String       @id @default(cuid())
  code      String       @unique
  teamId    String
  createdBy String
  expiresAt DateTime
  maxUses   Int          @default(5)
  usedCount Int          @default(0)
  createdAt DateTime     @default(now())
  creator   User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members   TeamMember[]

  @@index([teamId])
  @@index([code])
  @@index([createdBy])
  @@map("invite_codes")
}

model MultipartUpload {
  id        String   @id @default(cuid())
  uploadId  String   @unique
  userId    String
  filename  String
  fileSize  BigInt
  mimeType  String
  bucket    String
  objectKey String
  parts     String   @default("[]")
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([uploadId])
  @@index([status])
  @@index([expiresAt])
  @@map("multipart_uploads")
}

model Collection {
  id        String           @id @default(cuid())
  userId    String
  name      String?
  fileCount Int              @default(0)
  totalSize BigInt           @default(0)
  shortCode String?          @unique
  shortUrl  String?
  expiresAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  items     CollectionItem[]
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shortCode])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("collections")
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  fileId       String
  order        Int
  createdAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  file         File       @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([collectionId, fileId])
  @@index([collectionId, order])
  @@index([fileId])
  @@map("collection_items")
}
